@{
    var cuentas = (List<BancaEnLinea.Models.Account>)ViewBag.Cuentas;
    var error = ViewBag.Error as string;
}
<h2>Pago de Servicios</h2>
@if (!string.IsNullOrWhiteSpace(error)) { <div class="alert alert-danger">@error</div> }
<form method="post">
  <div class="mb-3">
    <label class="form-label">Cuenta origen</label>
    <select name="cuentaOrigenId" class="form-select">
      @foreach (var c in cuentas) { <option value="@c.Id">@c.Name (₡ @c.Balance.ToString("N2"))</option> }
    </select>
  </div>
  <div class="mb-3"><label class="form-label">Servicio</label><input name="servicio" class="form-control" placeholder="Agua, Luz, etc."/></div>
  <div class="mb-3"><label class="form-label">Referencia</label><input name="referencia" class="form-control"/></div>
  <div class="mb-3"><label class="form-label">Monto</label><input name="monto" type="number" step="0.01" class="form-control"/></div>
  <button class="btn btn-primary">Pagar</button>
  <a class="btn btn-secondary" href="/Accounts/Overview">Cancelar</a>
</form>

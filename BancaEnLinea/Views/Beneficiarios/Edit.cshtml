@model BancaEnLinea.Models.Beneficiario
@{
    var error = ViewBag.Error as string;
}
<h2>Editar Beneficiario</h2>
@if (!string.IsNullOrWhiteSpace(error)) { <div class="alert alert-danger">@error</div> }
<form method="post" action="/Beneficiarios/Edit/@Model.Id">
  <div class="mb-3"><label class="form-label">Alias</label><input name="alias" class="form-control" value="@Model.Alias"/></div>
  <div class="mb-3"><label class="form-label">Banco</label><input name="banco" class="form-control" value="@Model.Banco"/></div>
  <div class="mb-3"><label class="form-label">Número de cuenta</label><input name="numeroCuenta" class="form-control" value="@Model.NumeroCuenta"/></div>
  <button class="btn btn-primary">Guardar</button>
  <a class="btn btn-secondary" href="/Beneficiarios">Volver</a>
</form>
